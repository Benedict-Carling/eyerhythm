{
  "name": "eyeryhthm",
  "version": "1.19.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "author": {
    "name": "EyeRhythm",
    "email": "eyerhythm@users.noreply.github.com"
  },
  "description": "Privacy-focused real-time eye movement tracking application",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Benedict-Carling/eyeryhthm.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "playwright test --reporter=line",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "prepare": "husky",
    "verify": "npm run typecheck && npm run lint && npm run test:unit -- --run",
    "electron:dev": "concurrently -k \"npm run dev -- --port 3000\" \"npm run electron:start\"",
    "electron:start": "wait-on http://localhost:3000 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run verify && ELECTRON_BUILD=true npm run build && tsc -p electron/tsconfig.json && electron-builder --config electron-builder.config.js",
    "electron:build:mac": "npm run verify && ELECTRON_BUILD=true npm run build && tsc -p electron/tsconfig.json && electron-builder --mac --config electron-builder.config.js",
    "electron:build:win": "npm run verify && ELECTRON_BUILD=true npm run build && tsc -p electron/tsconfig.json && electron-builder --win --config electron-builder.config.js",
    "electron:build:linux": "npm run verify && ELECTRON_BUILD=true npm run build && tsc -p electron/tsconfig.json && electron-builder --linux --config electron-builder.config.js",
    "email:dev": "email dev"
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@react-email/components": "^0.0.25",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.10",
    "react-day-picker": "^9.12.0",
    "resend": "^4.0.0",
    "standardwebhooks": "^1.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@mediapipe/tasks-vision": "0.10.21",
    "@playwright/test": "^1.55.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@sentry/nextjs": "^10.29.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/dom-mediacapture-transform": "^0.1.11",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "electron-squirrel-startup": "^1.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.525.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  }
}
